rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identidad y rol ──────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isActive() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }
    function hasRole(roles) { return isActive() && get(userPath(request.auth.uid)).data.role in roles; }
    function isAdmin() { return hasRole(['admin']); }
    function canEdit() { return hasRole(['admin', 'member']); }
    function isGuest() { return hasRole(['guest']); }
    // Admin, miembro y lector ven todo el espacio; el Invitado, solo sus proyectos.
    function isTeam() { return hasRole(['admin', 'member', 'viewer']); }
    // Solo admin y miembro ven las tareas hechas (Lector e Invitado, nunca).
    function seesDone() { return hasRole(['admin', 'member']); }
    function myEmail() { return request.auth.token.email; }
    function emailVerified() { return request.auth.token.email_verified == true; }

    // ─── Auditoría obligatoria ────────────────────────────────────
    // Cada cambio en un documento auditado debe ir acompañado (en el mismo batch/transacción)
    // de auditLog/{tipo}_{id}_{rev}, con fotos before/after que coinciden con los datos reales.
    function entityPath(type, id) {
      return type == 'task' ? /databases/$(database)/documents/tasks/$(id)
        : type == 'invitation' ? /databases/$(database)/documents/invitations/$(id)
        : type == 'project' ? /databases/$(database)/documents/projects/$(id)
        : type == 'settings' ? /databases/$(database)/documents/settings/$(id)
        : /databases/$(database)/documents/users/$(id);
    }
    function audited(type, id, rev) {
      return existsAfter(/databases/$(database)/documents/auditLog/$(type + '_' + id + '_' + string(rev)));
    }
    function nextRev() { return request.resource.data.rev == resource.data.rev + 1; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function validAudit(logId) {
      let d = request.resource.data;
      let path = entityPath(d.entityType, d.entityId);
      return d.keys().hasOnly(['entityType', 'entityId', 'rev', 'action', 'actorId', 'at', 'before', 'after'])
        && d.entityType in ['task', 'invitation', 'user', 'project', 'settings']
        && logId == d.entityType + '_' + d.entityId + '_' + string(d.rev)
        && d.actorId == request.auth.uid
        && d.at == request.time
        && (
          (d.action == 'create' && !exists(path) && existsAfter(path)
            && d.before == null && d.after == getAfter(path).data && getAfter(path).data.rev == d.rev)
          || (d.action == 'update' && exists(path) && existsAfter(path)
            && d.before == get(path).data && d.after == getAfter(path).data && getAfter(path).data.rev == d.rev)
          || (d.action == 'delete' && exists(path) && !existsAfter(path)
            && d.before == get(path).data && d.after == null && get(path).data.rev + 1 == d.rev)
        );
    }

    match /auditLog/{logId} {
      allow read: if isAdmin()
        || (hasRole(['member']) && resource.data.entityType in ['task', 'project'])
        || (hasRole(['viewer']) && resource.data.entityType == 'project')
        || (hasRole(['viewer']) && resource.data.entityType == 'task' && openTask(resource.data.entityId))
        || (isGuest() && resource.data.entityType == 'task'
            && openTask(resource.data.entityId) && guestIn(get(taskPath(resource.data.entityId)).data.projectId))
        || (isGuest() && resource.data.entityType == 'project' && guestIn(resource.data.entityId));
      allow create: if signedIn() && validAudit(logId);
      allow update, delete: if false;
    }

    // ─── Tareas (todo el equipo las ve) ───────────────────────────
    function validTask(d) {
      return d.keys().hasOnly(['createdBy', 'title', 'description', 'status', 'assigneeId', 'completedBy', 'completedAt',
                               'projectId', 'number', 'subtasks', 'priority', 'dueDate', 'createdAt', 'updatedAt', 'updatedBy', 'rev'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 500
        && d.status in ['todo', 'doing', 'done']
        && (d.assigneeId == null || d.assigneeId is string)
        && (d.projectId == null || d.projectId is string)
        && d.number is int && d.number >= 1
        && d.subtasks is list && d.subtasks.size() <= 20
        && d.priority in ['alta', 'media', 'baja']
        && (d.dueDate == null || (d.dueDate is string && d.dueDate.size() == 10))
        && d.rev is int
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    function counterPath() { return /databases/$(database)/documents/counters/tasks; }

    function projectPath(id) { return /databases/$(database)/documents/projects/$(id); }
    function taskPath(id) { return /databases/$(database)/documents/tasks/$(id); }
    // Tarea que existe y no está hecha (lo único que Lector e Invitado pueden ver).
    function openTask(id) { return exists(taskPath(id)) && get(taskPath(id)).data.status in ['todo', 'doing']; }
    function memberIdsOf(p) { return p.get('memberIds', []); }

    // El Invitado está en la lista de personas del proyecto.
    function guestIn(pid) {
      return pid != null && exists(projectPath(pid)) && request.auth.uid in memberIdsOf(get(projectPath(pid)).data);
    }
    // Persona del proyecto: su responsable o alguien de la lista.
    function inProject(uid, pid) {
      return pid != null && exists(projectPath(pid))
        && (uid == get(projectPath(pid)).data.ownerId || uid in memberIdsOf(get(projectPath(pid)).data));
    }
    // El Invitado puede trabajar en el proyecto: está en la lista y su acceso es "Puede editar" (sin entrada = editar).
    function guestEdits(pid) {
      return guestIn(pid) && get(projectPath(pid)).data.get('guestAccess', {}).get(request.auth.uid, 'edit') == 'edit';
    }
    // Admin y miembro trabajan en cualquier tarea; el Invitado solo en sus proyectos donde "Puede editar".
    function canWork(pid) { return canEdit() || (isGuest() && guestEdits(pid)); }

    // Proyecto de una tarea: debe existir y no estar archivado (solo se revisa cuando cambia).
    function validProjectRef(id) {
      return id == null || (exists(projectPath(id)) && get(projectPath(id)).data.archived == false);
    }

    // Responsable de un proyecto: admin o miembro activo (solo se revisa cuando cambia).
    function validOwner(uid) {
      return exists(userPath(uid))
        && get(userPath(uid)).data.active == true
        && get(userPath(uid)).data.role in ['admin', 'member'];
    }
    function isGuestUser(uid) { return uid != null && exists(userPath(uid)) && get(userPath(uid)).data.role == 'guest'; }

    // Responsable de una tarea: admin o miembro activo, o un Invitado activo que esté en el proyecto de la tarea.
    function validAssignee(uid, pid) {
      return uid == null || validOwner(uid)
        || (isGuestUser(uid) && get(userPath(uid)).data.active == true
            && pid != null && exists(projectPath(pid)) && uid in memberIdsOf(get(projectPath(pid)).data));
    }
    // Si quien asigna es Invitado, solo puede elegir personas del proyecto.
    function guestAssigns(uid, pid) { return !isGuest() || uid == null || inProject(uid, pid); }

    // Completado honesto: quien la pasa a Hecha y la hora del servidor; nadie lo reescribe después.
    function completionOnCreate(d) {
      return d.status == 'done'
        ? d.completedBy == request.auth.uid && d.completedAt == request.time
        : d.completedBy == null && d.completedAt == null;
    }
    function completionOnUpdate(d, old) {
      return d.status != 'done'
        ? d.completedBy == null && d.completedAt == null
        : old.status == 'done'
          ? d.completedBy == old.completedBy && d.completedAt == old.completedAt
          : d.completedBy == request.auth.uid && d.completedAt == request.time;
    }

    match /tasks/{taskId} {
      allow read: if seesDone()
        || (hasRole(['viewer']) && resource.data.status in ['todo', 'doing'])
        || (isGuest() && resource.data.status in ['todo', 'doing'] && guestIn(resource.data.projectId));
      allow create: if canWork(request.resource.data.projectId)
        && validTask(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.rev == 1
        && validAssignee(request.resource.data.assigneeId, request.resource.data.projectId)
        && guestAssigns(request.resource.data.assigneeId, request.resource.data.projectId)
        && completionOnCreate(request.resource.data)
        && validProjectRef(request.resource.data.projectId)
        && request.resource.data.number == get(counterPath()).data.next
        && getAfter(counterPath()).data.next == request.resource.data.number + 1
        && audited('task', taskId, 1);
      allow update: if canWork(request.resource.data.projectId)
        // El Invitado tampoco puede traer una tarea de un proyecto ajeno.
        && (canEdit() || guestEdits(resource.data.projectId))
        && validTask(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.number == resource.data.number
        && (!changed().hasAny(['assigneeId'])
            || (validAssignee(request.resource.data.assigneeId, request.resource.data.projectId)
                && guestAssigns(request.resource.data.assigneeId, request.resource.data.projectId)))
        // Si la tarea cambia de proyecto y su responsable es Invitado, tiene que estar también en el nuevo.
        && (!changed().hasAny(['projectId']) || !isGuestUser(request.resource.data.assigneeId)
            || validAssignee(request.resource.data.assigneeId, request.resource.data.projectId))
        && completionOnUpdate(request.resource.data, resource.data)
        && (!changed().hasAny(['projectId']) || validProjectRef(request.resource.data.projectId))
        && nextRev()
        && audited('task', taskId, request.resource.data.rev);
      allow delete: if (isAdmin()
          || (hasRole(['member']) && resource.data.createdBy == request.auth.uid)
          || (isGuest() && resource.data.createdBy == request.auth.uid && guestEdits(resource.data.projectId)))
        && audited('task', taskId, resource.data.rev + 1);
    }

    // ─── Contador de números de tarea (lo crea la migración) ──────
    match /counters/tasks {
      allow read: if isActive();
      allow update: if (canEdit() || isGuest())
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1;
    }

    // ─── Proyectos ────────────────────────────────────────────────
    function validProject(d) {
      return d.keys().hasOnly(['name', 'description', 'color', 'ownerId', 'startDate', 'endDate', 'archived',
                               'memberIds', 'guestAccess', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'rev'])
        && (!('memberIds' in d) || (d.memberIds is list && d.memberIds.size() <= 50))
        && (!('guestAccess' in d) || (d.guestAccess is map && d.guestAccess.size() <= 50))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.description is string && d.description.size() <= 500
        && d.color is string && d.color.matches('^#[0-9A-Fa-f]{6}$')
        && d.ownerId is string
        && d.startDate is string && d.startDate.size() == 10
        && d.endDate is string && d.endDate.size() == 10
        && d.endDate >= d.startDate
        && d.archived is bool
        && d.rev is int
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    // Tarjeta de una persona del proyecto: copia fiel de su perfil (después de la escritura).
    function cardMatches(uid) {
      let d = request.resource.data;
      let u = getAfter(userPath(uid)).data;
      return d.keys().hasOnly(['uid', 'displayName', 'photo', 'active', 'role'])
        && d.uid == uid
        && d.displayName == u.displayName
        && d.photo == u.get('photo', null)
        && d.active == u.active
        && d.role == (u.role == 'guest' ? 'guest' : 'team');
    }
    function personOfProjectAfter(pid, uid) {
      let p = getAfter(projectPath(pid)).data;
      return uid == p.ownerId || uid in p.get('memberIds', []);
    }

    match /projects/{projectId} {
      allow read: if isTeam() || (isGuest() && 'memberIds' in resource.data && request.auth.uid in resource.data.memberIds);
      allow create: if canEdit()
        && validProject(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.rev == 1
        && request.resource.data.archived == false
        && validOwner(request.resource.data.ownerId)
        && (!('memberIds' in request.resource.data) || isAdmin())
        && (!('guestAccess' in request.resource.data) || isAdmin())
        && audited('project', projectId, 1);
      allow update: if canEdit()
        && validProject(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (!changed().hasAny(['ownerId']) || validOwner(request.resource.data.ownerId))
        && (!changed().hasAny(['memberIds', 'guestAccess']) || isAdmin())
        && nextRev()
        && audited('project', projectId, request.resource.data.rev);
      allow delete: if isAdmin() && audited('project', projectId, resource.data.rev + 1);

      // Tarjetas: lo único que el Invitado ve de las personas (sin email ni rol).
      match /people/{uid} {
        allow read: if isTeam() || (isGuest() && guestIn(projectId));
        allow create, update: if isActive() && existsAfter(projectPath(projectId))
          && personOfProjectAfter(projectId, uid) && cardMatches(uid);
        allow delete: if isActive()
          && (!existsAfter(projectPath(projectId)) || !personOfProjectAfter(projectId, uid));
      }
    }

    // ─── Ajustes del espacio (lectura pública: el login muestra nombre, logo y colores) ───
    function validSettings(d) {
      return d.keys().hasOnly(['name', 'logo', 'palette', 'taskPrefix', 'updatedAt', 'updatedBy', 'rev'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (d.logo == null || (d.logo is string && d.logo.size() <= 100000 && d.logo.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')))
        && d.palette is list && d.palette.size() == 5
        && d.palette[0].matches('^#[0-9A-Fa-f]{6}$') && d.palette[1].matches('^#[0-9A-Fa-f]{6}$')
        && d.palette[2].matches('^#[0-9A-Fa-f]{6}$') && d.palette[3].matches('^#[0-9A-Fa-f]{6}$')
        && d.palette[4].matches('^#[0-9A-Fa-f]{6}$')
        && d.taskPrefix is string && d.taskPrefix.matches('^[A-Z0-9]{1,5}$')
        && d.rev is int
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /settings/workspace {
      allow read: if true;
      allow create: if isAdmin() && validSettings(request.resource.data) && request.resource.data.rev == 1
        && audited('settings', 'workspace', 1);
      allow update: if isAdmin() && validSettings(request.resource.data) && nextRev()
        && audited('settings', 'workspace', request.resource.data.rev);
    }

    // ─── Invitaciones (ID = email en minúsculas) ──────────────────
    function invitationPath(email) { return /databases/$(database)/documents/invitations/$(email); }

    match /invitations/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);

      allow create: if isAdmin()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'role', 'status', 'invitedBy', 'createdAt', 'acceptedBy', 'acceptedAt', 'rev'])
        && request.resource.data.email == email
        && request.resource.data.role in ['admin', 'member', 'viewer', 'guest']
        && request.resource.data.status == 'pending'
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.acceptedBy == null
        && request.resource.data.acceptedAt == null
        && request.resource.data.rev == 1
        && audited('invitation', email, 1);

      allow update: if nextRev() && audited('invitation', email, request.resource.data.rev) && (
        // Un admin cancela una invitación pendiente
        (isAdmin() && resource.data.status == 'pending' && request.resource.data.status == 'revoked'
          && changed().hasOnly(['status', 'rev']))
        // Un admin vuelve a invitar un email cancelado
        || (isAdmin() && resource.data.status == 'revoked' && request.resource.data.status == 'pending'
          && request.resource.data.role in ['admin', 'member', 'viewer', 'guest']
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && changed().hasOnly(['status', 'role', 'invitedBy', 'createdAt', 'rev']))
        // La persona invitada acepta, junto con la creación de su perfil
        || (signedIn() && emailVerified() && myEmail() == email
          && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && changed().hasOnly(['status', 'acceptedBy', 'acceptedAt', 'rev'])
          && existsAfter(userPath(request.auth.uid)))
      );
      allow delete: if false;
    }

    // ─── Usuarios ─────────────────────────────────────────────────
    // Foto de perfil: JPEG en data URL, chica (la app la reduce a 128×128 antes de guardarla).
    function validPhoto(d) {
      return !('photo' in d) || d.photo == null
        || (d.photo is string && d.photo.size() <= 50000
            && d.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }

    match /users/{uid} {
      // El propio documento se puede leer aunque no exista o esté desactivado (para saber el estado de acceso)
      allow read: if isTeam() || (signedIn() && request.auth.uid == uid);

      // Solo reclamando una invitación pendiente del propio email verificado
      allow create: if signedIn() && request.auth.uid == uid && emailVerified()
        && exists(invitationPath(myEmail()))
        && get(invitationPath(myEmail())).data.status == 'pending'
        && getAfter(invitationPath(myEmail())).data.status == 'accepted'
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'active', 'invitedBy', 'joinedAt', 'rev'])
        && request.resource.data.email == myEmail()
        && request.resource.data.role == get(invitationPath(myEmail())).data.role
        && request.resource.data.invitedBy == get(invitationPath(myEmail())).data.invitedBy
        && request.resource.data.active == true
        && request.resource.data.joinedAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.rev == 1
        && audited('user', uid, 1);

      allow update: if nextRev() && audited('user', uid, request.resource.data.rev) && (
        // Un admin cambia el rol o el estado de OTRA persona (nunca el suyo)
        (isAdmin() && uid != request.auth.uid
          && changed().hasOnly(['role', 'active', 'rev'])
          && request.resource.data.role in ['admin', 'member', 'viewer', 'guest']
          && request.resource.data.active is bool)
        // Cada persona activa cambia su propio nombre y su foto
        || (isActive() && uid == request.auth.uid
          && changed().hasOnly(['displayName', 'photo', 'rev'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && validPhoto(request.resource.data))
      );
      allow delete: if false;
    }

    // Buscar las tarjetas de una persona en todos los proyectos (para actualizarlas).
    match /{path=**}/people/{uid} {
      allow read: if isTeam() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
