    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/node": "^16.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.33.0",
    "jsdom": "^29.1.1",
